# Copy this file to .env and fill it in. .env is git-ignored, so keep real values out of git, chat, and screenshots.
# Without these, Relay runs in simulated mode: offers appear in the Doctor phone tab and no text is sent.

# From the Twilio console (Account Info). The sender is a Twilio number or a Messaging Service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# TWILIO_MESSAGING_SERVICE_SID=

# Where Twilio can reach this app from the internet (an ngrok or App Runner https URL, no trailing slash).
# Needed for text replies and delivery status. In the Twilio console, set the number's "A message comes in"
# webhook to <this URL>/api/twilio/sms (HTTP POST).
RELAY_PUBLIC_URL=

# One phone that receives every doctor's offer (for demos; on a trial account it must be a verified number).
RELAY_DEMO_PHONE=+1XXXXXXXXXX
# Or give doctors their own numbers (these win over the demo phone):
# RELAY_DOCTOR_PHONES={"PHY-009": "+1XXXXXXXXXX", "PHY-011": "+1XXXXXXXXXX"}
